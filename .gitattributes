*.php linguist-language=PHP

# Root assets — minified/generated/vendor files
assets/css/** linguist-vendored=true
assets/js/main.min.js linguist-vendored=true
assets/js/*.min.js linguist-vendored=true
assets/js/echarts.min.js linguist-vendored=true
assets/js/world.js linguist-vendored=true
assets/js/strip.pkgd.min.js linguist-vendored=true
assets/fonts/** linguist-vendored=true

# Admin theme CSS and JS (copied from admin template, not authored)
admin/css/** linguist-vendored=true
admin/js/** linguist-vendored=true

# Admin panel authored CSS (large login.css etc. are template files)
admin/admin/*.css linguist-vendored=true
admin/admin/chat/css/** linguist-vendored=true

# Admin vendor libraries (bootstrap, jquery, fontawesome, etc.)
admin/assets/vendor/** linguist-vendored=true

# Admin theme distributed assets
admin/assets/custom/** linguist-vendored=true
